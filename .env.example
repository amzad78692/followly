APP_NAME=Followly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=followly
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Jobs run from the database queue: cron runs the scheduler, which starts the worker (scripts/queue.sh).
QUEUE_CONNECTION=database

# The cache holds the YouTube quota count, Apify lookup results and rate limits; deploys keep it.
CACHE_STORE=database
# CACHE_PREFIX=
# SETTINGS_CACHE_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs. In production use smtp (e.g. the cPanel mailbox:
# MAIL_HOST=mail.yourdomain.com, MAIL_PORT=465, MAIL_SCHEME=smtps), since password resets,
# digests and admin alerts (failed jobs, sync errors, backups, Apify budget) are sent by email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_AUTO_CLEANUP_ENABLED=true
LOG_MAX_ENTRIES_TO_KEEP=1000
LOG_CLEANUP_STRATEGY=truncate_oldest

MF_CALLBACK="${APP_URL}"
MF_API_KEY=
MF_IS_TEST=true
# Platform drivers (Phase 5)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_X_ACTOR=apidojo/tweet-scraper
APIFY_WAIT_SECONDS=60
APIFY_TIMEOUT_SECONDS=300
APIFY_MONTHLY_BUDGET_USD=
APIFY_BATCH_SIZE=20
PLATFORM_DISCOVER_SAME_HANDLE=true
PLATFORM_POSTS_PER_FETCH=20
PLATFORM_RESOLVE_CACHE_MINUTES=1440
# Requests per minute to each platform
YOUTUBE_RATE_LIMIT=120
INSTAGRAM_RATE_LIMIT=10
TIKTOK_RATE_LIMIT=10
X_RATE_LIMIT=10

# Syncing (Phase 6): minutes between post syncs, and the most accounts queued per platform per run
YOUTUBE_SYNC_MINUTES=30
INSTAGRAM_SYNC_MINUTES=120
TIKTOK_SYNC_MINUTES=120
X_SYNC_MINUTES=120
YOUTUBE_SYNC_MAX=300
INSTAGRAM_SYNC_MAX=100
TIKTOK_SYNC_MAX=100
X_SYNC_MAX=100
PLATFORM_SYNC_QUEUE=platforms
PLATFORM_FAILED_RETRY_HOURS=24
SNAPSHOT_RETENTION_DAYS=400
APIFY_RUN_RETENTION_DAYS=400
DB_QUEUE_RETRY_AFTER=660

# Discovery (config/discovery.php)
TRENDING_DAYS=7
TRENDING_FOLLOW_WEIGHT=1
TRENDING_GROWTH_WEIGHT=2
TRENDING_GROWTH_CAP=50
RECOMMENDED_CATEGORIES=3

# Notifications (config/notifications.php)
NOTIFY_MAX_POST_AGE_HOURS=48
DIGEST_TIME=08:00
DIGEST_MAX_ITEMS=20
NOTIFICATION_RETENTION_DAYS=90
DAILY_SUMMARY_HOUR=20

# Push to watches and phones (config/services.php). A provider left empty is skipped.
FCM_CREDENTIALS_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_SANDBOX=false
APNS_WATCH_TOPIC=com.followly.watch
APNS_PHONE_TOPIC=com.followly.companion
HMS_PUSH_APP_ID=
HMS_PUSH_APP_SECRET=

# Platform images (Phase 12): served through the image.remote proxy, see config/images.php
IMAGE_PROXY=true
IMAGE_PROXY_TIMEOUT=5
IMAGE_CACHE_DAYS=30

# Monitoring and backups (config/operations.php)
MONITOR_SYNC_ERROR_RATE=0.25
MONITOR_SYNC_MIN_FAILED=3
# "local" keeps backups on this server (storage/app/private/backups); use an off-site disk such as s3 if you can.
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
BACKUP_MYSQLDUMP_PATH=mysqldump

# Admin dashboard traffic (GA4 Data API). The service account needs Viewer access to the property.
# Keep the JSON key outside the repo. The tracking tag ID is set in Admin > Settings > General.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
