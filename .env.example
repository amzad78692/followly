APP_NAME=Followly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
# SETTINGS_CACHE_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_AUTO_CLEANUP_ENABLED=true
LOG_MAX_ENTRIES_TO_KEEP=1000
LOG_CLEANUP_STRATEGY=truncate_oldest

MF_CALLBACK="${APP_URL}"
MF_API_KEY=
MF_IS_TEST=true
# Platform drivers (Phase 5)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_X_ACTOR=apidojo/tweet-scraper
APIFY_WAIT_SECONDS=60
APIFY_TIMEOUT_SECONDS=300
APIFY_MONTHLY_BUDGET_USD=
APIFY_BATCH_SIZE=20
PLATFORM_DISCOVER_SAME_HANDLE=true

# Syncing (Phase 6): minutes between post syncs
YOUTUBE_SYNC_MINUTES=30
INSTAGRAM_SYNC_MINUTES=120
TIKTOK_SYNC_MINUTES=120
X_SYNC_MINUTES=120
DB_QUEUE_RETRY_AFTER=660

# Discovery (config/discovery.php)
TRENDING_DAYS=7
TRENDING_FOLLOW_WEIGHT=1
TRENDING_GROWTH_WEIGHT=2
TRENDING_GROWTH_CAP=50
RECOMMENDED_CATEGORIES=3
